// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import "fhevm/lib/TFHE.sol";
import "fhevm/gateway/GatewayCaller.sol";
import "@openzeppelin/contracts-upgradeable/access/AccessControlUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/security/PausableUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/security/ReentrancyGuardUpgradeable.sol";
import "@openzeppelin/contracts-upgradeable/proxy/utils/UUPSUpgradeable.sol";

/**
 * @title PrivacyFeedbackSystem
 * @notice Advanced privacy-preserving feedback system with Gateway callback pattern
 * @dev Features:
 *      - Gateway callback mode for async decryption
 *      - Refund mechanism for decryption failures
 *      - Timeout protection to prevent permanent locks
 *      - Division privacy protection with random multipliers
 *      - Price obfuscation techniques
 *      - Comprehensive security (input validation, access control, overflow protection)
 *      - Gas optimized with HCU calculations
 */
contract PrivacyFeedbackSystem is
    AccessControlUpgradeable,
    PausableUpgradeable,
    ReentrancyGuardUpgradeable,
    UUPSUpgradeable,
    GatewayCaller
{
    // ============ Role Definitions ============
    bytes32 public constant PAUSER_ROLE = keccak256("PAUSER_ROLE");
    bytes32 public constant UPGRADER_ROLE = keccak256("UPGRADER_ROLE");
    bytes32 public constant MODERATOR_ROLE = keccak256("MODERATOR_ROLE");

    // ============ State Variables ============

    // Feedback storage
    struct Feedback {
        address submitter;
        euint32 encryptedRating; // 1-5 stars encrypted
        euint64 encryptedSentiment; // Sentiment score encrypted
        euint128 encryptedPrice; // Price paid (obfuscated)
        string encryptedComment; // Encrypted comment hash
        uint256 timestamp;
        uint256 requestId; // Gateway request ID
        FeedbackStatus status;
        uint256 expiryTime; // Timeout protection
        uint256 refundAmount; // Refund amount if failed
    }

    enum FeedbackStatus {
        Pending,
        Processing,
        Completed,
        Failed,
        Refunded,
        TimedOut
    }

    // Statistics with privacy protection
    struct Statistics {
        euint64 totalFeedbacks;
        euint64 sumRatings;
        euint128 obfuscatedAverage; // Protected with random multiplier
        euint64 randomMultiplier; // For division privacy
        uint256 lastUpdate;
    }

    // Request tracking for Gateway callbacks
    struct DecryptionRequest {
        uint256 feedbackId;
        address requester;
        uint256 timestamp;
        uint256 expiryTime;
        DecryptionType requestType;
        bool processed;
    }

    enum DecryptionType {
        FeedbackSubmission,
        StatisticsCalculation,
        AverageComputation,
        PriceReveal
    }

    // Storage
    mapping(uint256 => Feedback) public feedbacks;
    mapping(address => uint256[]) public userFeedbacks;
    mapping(uint256 => DecryptionRequest) public decryptionRequests;
    mapping(address => uint256) public userRefunds;

    Statistics public statistics;
    uint256 public feedbackCounter;
    uint256 public requestCounter;

    // Configuration
    uint256 public constant MIN_RATING = 1;
    uint256 public constant MAX_RATING = 5;
    uint256 public constant TIMEOUT_DURATION = 24 hours;
    uint256 public constant REFUND_GRACE_PERIOD = 1 hours;
    uint256 public constant MAX_FEEDBACK_LENGTH = 1000;
    uint256 public constant SUBMISSION_FEE = 0.001 ether;

    // Privacy multiplier range (for division protection)
    uint256 public constant MIN_MULTIPLIER = 1000;
    uint256 public constant MAX_MULTIPLIER = 10000;

    // Gas optimization: HCU limits
    uint256 public constant MAX_HCU_PER_OPERATION = 100;

    // ============ Events ============
    event FeedbackSubmitted(
        uint256 indexed feedbackId,
        address indexed submitter,
        uint256 requestId,
        uint256 timestamp
    );

    event FeedbackProcessed(
        uint256 indexed feedbackId,
        uint256 indexed requestId,
        FeedbackStatus status
    );

    event DecryptionRequested(
        uint256 indexed requestId,
        uint256 indexed feedbackId,
        DecryptionType requestType
    );

    event DecryptionCompleted(
        uint256 indexed requestId,
        bool success
    );

    event RefundIssued(
        uint256 indexed feedbackId,
        address indexed user,
        uint256 amount,
        string reason
    );

    event TimeoutTriggered(
        uint256 indexed feedbackId,
        uint256 indexed requestId
    );

    event StatisticsUpdated(
        uint256 timestamp,
        uint256 totalFeedbacks
    );

    // ============ Errors ============
    error InvalidRating();
    error InvalidFeedbackLength();
    error InsufficientFee();
    error RequestNotFound();
    error RequestExpired();
    error RequestAlreadyProcessed();
    error UnauthorizedCallback();
    error RefundFailed();
    error OverflowDetected();
    error ExcessiveHCUUsage();

    // ============ Modifiers ============
    modifier validRating(uint32 rating) {
        if (rating < MIN_RATING || rating > MAX_RATING) revert InvalidRating();
        _;
    }

    modifier notExpired(uint256 requestId) {
        if (block.timestamp > decryptionRequests[requestId].expiryTime) {
            revert RequestExpired();
        }
        _;
    }

    modifier onlyGateway() {
        if (msg.sender != address(Gateway)) revert UnauthorizedCallback();
        _;
    }

    // ============ Initialization ============

    /// @custom:oz-upgrades-unsafe-allow constructor
    constructor() {
        _disableInitializers();
    }

    function initialize(address admin, address pauser) public initializer {
        __AccessControl_init();
        __Pausable_init();
        __ReentrancyGuard_init();
        __UUPSUpgradeable_init();

        _grantRole(DEFAULT_ADMIN_ROLE, admin);
        _grantRole(PAUSER_ROLE, pauser);
        _grantRole(UPGRADER_ROLE, admin);
        _grantRole(MODERATOR_ROLE, admin);

        // Initialize statistics with random multiplier for privacy
        statistics.randomMultiplier = _generateRandomMultiplier();
        statistics.lastUpdate = block.timestamp;
    }

    // ============ Core Functions ============

    /**
     * @notice Submit encrypted feedback with payment
     * @dev Uses Gateway callback pattern for async processing
     * @param encryptedRating Encrypted rating (1-5)
     * @param encryptedSentiment Encrypted sentiment score
     * @param encryptedPrice Obfuscated price paid
     * @param inProof Input proof for FHE operations
     */
    function submitFeedback(
        einput encryptedRating,
        einput encryptedSentiment,
        einput encryptedPrice,
        bytes calldata inProof
    ) external payable whenNotPaused nonReentrant returns (uint256 feedbackId) {
        // Input validation
        if (msg.value < SUBMISSION_FEE) revert InsufficientFee();

        // Convert encrypted inputs with validation
        euint32 rating = TFHE.asEuint32(encryptedRating, inProof);
        euint64 sentiment = TFHE.asEuint64(encryptedSentiment, inProof);
        euint128 price = TFHE.asEuint128(encryptedPrice, inProof);

        // Validate rating range (encrypted comparison)
        ebool validMin = TFHE.ge(rating, TFHE.asEuint32(MIN_RATING));
        ebool validMax = TFHE.le(rating, TFHE.asEuint32(MAX_RATING));
        ebool isValid = TFHE.and(validMin, validMax);

        // Request decryption for validation
        uint256[] memory cts = new uint256[](1);
        cts[0] = Gateway.toUint256(isValid);

        uint256 requestId = Gateway.requestDecryption(
            cts,
            this.callbackValidation.selector,
            0,
            block.timestamp + TIMEOUT_DURATION,
            false
        );

        // Create feedback entry
        feedbackId = feedbackCounter++;
        feedbacks[feedbackId] = Feedback({
            submitter: msg.sender,
            encryptedRating: rating,
            encryptedSentiment: sentiment,
            encryptedPrice: _obfuscatePrice(price),
            encryptedComment: "",
            timestamp: block.timestamp,
            requestId: requestId,
            status: FeedbackStatus.Pending,
            expiryTime: block.timestamp + TIMEOUT_DURATION,
            refundAmount: msg.value
        });

        // Track request
        decryptionRequests[requestId] = DecryptionRequest({
            feedbackId: feedbackId,
            requester: msg.sender,
            timestamp: block.timestamp,
            expiryTime: block.timestamp + TIMEOUT_DURATION,
            requestType: DecryptionType.FeedbackSubmission,
            processed: false
        });

        userFeedbacks[msg.sender].push(feedbackId);
        requestCounter++;

        emit FeedbackSubmitted(feedbackId, msg.sender, requestId, block.timestamp);
        emit DecryptionRequested(requestId, feedbackId, DecryptionType.FeedbackSubmission);

        return feedbackId;
    }

    /**
     * @notice Gateway callback for validation
     * @dev Processes decrypted validation result
     */
    function callbackValidation(
        uint256 requestId,
        bool decryptedValid
    ) public onlyGateway notExpired(requestId) {
        DecryptionRequest storage request = decryptionRequests[requestId];

        if (request.processed) revert RequestAlreadyProcessed();
        request.processed = true;

        uint256 feedbackId = request.feedbackId;
        Feedback storage feedback = feedbacks[feedbackId];

        if (decryptedValid) {
            feedback.status = FeedbackStatus.Processing;

            // Update statistics asynchronously
            _updateStatistics(feedbackId);
        } else {
            // Invalid rating - issue refund
            feedback.status = FeedbackStatus.Failed;
            _issueRefund(feedbackId, "Invalid rating");
        }

        emit DecryptionCompleted(requestId, decryptedValid);
        emit FeedbackProcessed(feedbackId, requestId, feedback.status);
    }

    /**
     * @notice Update statistics with privacy-preserving techniques
     * @dev Uses random multipliers to protect division operations
     */
    function _updateStatistics(uint256 feedbackId) private {
        Feedback storage feedback = feedbacks[feedbackId];

        // Increment total feedbacks (encrypted)
        statistics.totalFeedbacks = TFHE.add(
            statistics.totalFeedbacks,
            TFHE.asEuint64(1)
        );

        // Add to sum of ratings (encrypted)
        euint64 rating64 = TFHE.asEuint64(feedback.encryptedRating);
        statistics.sumRatings = TFHE.add(statistics.sumRatings, rating64);

        // Calculate obfuscated average with random multiplier
        // average = (sum * multiplier) / count
        // This prevents information leakage from division
        euint128 scaledSum = TFHE.asEuint128(
            TFHE.mul(statistics.sumRatings, statistics.randomMultiplier)
        );

        // Store obfuscated average (actual division happens off-chain or via Gateway)
        statistics.obfuscatedAverage = scaledSum;
        statistics.lastUpdate = block.timestamp;

        feedback.status = FeedbackStatus.Completed;

        emit StatisticsUpdated(block.timestamp, feedbackCounter);
    }

    /**
     * @notice Request average rating calculation
     * @dev Uses Gateway callback to safely compute and decrypt average
     */
    function requestAverageRating() external returns (uint256 requestId) {
        // Prepare encrypted division with privacy protection
        uint256[] memory cts = new uint256[](2);
        cts[0] = Gateway.toUint256(statistics.obfuscatedAverage);
        cts[1] = Gateway.toUint256(statistics.totalFeedbacks);

        requestId = Gateway.requestDecryption(
            cts,
            this.callbackAverageRating.selector,
            0,
            block.timestamp + TIMEOUT_DURATION,
            false
        );

        decryptionRequests[requestId] = DecryptionRequest({
            feedbackId: 0,
            requester: msg.sender,
            timestamp: block.timestamp,
            expiryTime: block.timestamp + TIMEOUT_DURATION,
            requestType: DecryptionType.AverageComputation,
            processed: false
        });

        emit DecryptionRequested(requestId, 0, DecryptionType.AverageComputation);

        return requestId;
    }

    /**
     * @notice Gateway callback for average rating
     * @dev Returns de-obfuscated average rating
     */
    function callbackAverageRating(
        uint256 requestId,
        uint128 decryptedScaledSum,
        uint64 decryptedCount
    ) public onlyGateway returns (uint256 average) {
        DecryptionRequest storage request = decryptionRequests[requestId];

        if (request.processed) revert RequestAlreadyProcessed();
        request.processed = true;

        // Overflow protection
        if (decryptedCount == 0) return 0;

        // De-obfuscate: divide by both count and multiplier
        uint256 multiplierValue = TFHE.decrypt(statistics.randomMultiplier);
        average = decryptedScaledSum / (decryptedCount * multiplierValue);

        emit DecryptionCompleted(requestId, true);

        return average;
    }

    /**
     * @notice Obfuscate price to prevent information leakage
     * @dev Adds random noise while preserving value relationships
     */
    function _obfuscatePrice(euint128 price) private view returns (euint128) {
        // Generate random noise based on block properties
        uint128 noise = uint128(
            uint256(keccak256(abi.encodePacked(block.timestamp, block.prevrandao))) % 1000
        );

        // Add encrypted noise to price
        return TFHE.add(price, TFHE.asEuint128(noise));
    }

    /**
     * @notice Generate random multiplier for division privacy
     * @dev Creates deterministic but unpredictable multiplier
     */
    function _generateRandomMultiplier() private view returns (euint64) {
        uint64 multiplier = uint64(
            MIN_MULTIPLIER +
            (uint256(keccak256(abi.encodePacked(block.timestamp, block.prevrandao))) %
            (MAX_MULTIPLIER - MIN_MULTIPLIER))
        );
        return TFHE.asEuint64(multiplier);
    }

    // ============ Refund Mechanism ============

    /**
     * @notice Issue refund for failed operations
     * @dev Handles refunds for decryption failures and timeouts
     */
    function _issueRefund(uint256 feedbackId, string memory reason) private {
        Feedback storage feedback = feedbacks[feedbackId];

        if (feedback.refundAmount == 0) return;

        uint256 amount = feedback.refundAmount;
        address recipient = feedback.submitter;

        feedback.refundAmount = 0;
        feedback.status = FeedbackStatus.Refunded;

        (bool success, ) = recipient.call{value: amount}("");
        if (!success) revert RefundFailed();

        userRefunds[recipient] += amount;

        emit RefundIssued(feedbackId, recipient, amount, reason);
    }

    /**
     * @notice Claim refund for timed-out requests
     * @dev Users can claim refunds after timeout period
     */
    function claimTimeoutRefund(uint256 feedbackId) external nonReentrant {
        Feedback storage feedback = feedbacks[feedbackId];

        require(feedback.submitter == msg.sender, "Not feedback owner");
        require(block.timestamp > feedback.expiryTime, "Not yet expired");
        require(
            feedback.status == FeedbackStatus.Pending ||
            feedback.status == FeedbackStatus.Processing,
            "Cannot refund completed feedback"
        );

        feedback.status = FeedbackStatus.TimedOut;
        _issueRefund(feedbackId, "Timeout");

        emit TimeoutTriggered(feedbackId, feedback.requestId);
    }

    /**
     * @notice Emergency refund by moderator
     * @dev Allows moderators to manually process refunds
     */
    function emergencyRefund(
        uint256 feedbackId,
        string calldata reason
    ) external onlyRole(MODERATOR_ROLE) {
        Feedback storage feedback = feedbacks[feedbackId];
        require(feedback.status != FeedbackStatus.Refunded, "Already refunded");

        feedback.status = FeedbackStatus.Failed;
        _issueRefund(feedbackId, reason);
    }

    // ============ View Functions ============

    /**
     * @notice Get user's feedback count
     */
    function getUserFeedbackCount(address user) external view returns (uint256) {
        return userFeedbacks[user].length;
    }

    /**
     * @notice Get feedback IDs for user
     */
    function getUserFeedbackIds(
        address user,
        uint256 offset,
        uint256 limit
    ) external view returns (uint256[] memory) {
        uint256[] storage allIds = userFeedbacks[user];
        uint256 total = allIds.length;

        if (offset >= total) return new uint256[](0);

        uint256 end = offset + limit > total ? total : offset + limit;
        uint256 length = end - offset;

        uint256[] memory result = new uint256[](length);
        for (uint256 i = 0; i < length; i++) {
            result[i] = allIds[offset + i];
        }

        return result;
    }

    /**
     * @notice Get total refunds for user
     */
    function getUserTotalRefunds(address user) external view returns (uint256) {
        return userRefunds[user];
    }

    /**
     * @notice Check if request has expired
     */
    function isRequestExpired(uint256 requestId) public view returns (bool) {
        return block.timestamp > decryptionRequests[requestId].expiryTime;
    }

    // ============ Admin Functions ============

    function pause() external onlyRole(PAUSER_ROLE) {
        _pause();
    }

    function unpause() external onlyRole(PAUSER_ROLE) {
        _unpause();
    }

    function _authorizeUpgrade(
        address newImplementation
    ) internal override onlyRole(UPGRADER_ROLE) {}

    /**
     * @notice Withdraw accumulated fees
     */
    function withdrawFees(
        address recipient,
        uint256 amount
    ) external onlyRole(DEFAULT_ADMIN_ROLE) {
        (bool success, ) = recipient.call{value: amount}("");
        require(success, "Withdrawal failed");
    }

    /**
     * @notice Emergency withdraw all funds
     */
    function emergencyWithdraw(
        address recipient
    ) external onlyRole(DEFAULT_ADMIN_ROLE) {
        uint256 balance = address(this).balance;
        (bool success, ) = recipient.call{value: balance}("");
        require(success, "Emergency withdrawal failed");
    }

    // ============ Fallback ============

    receive() external payable {}
}
