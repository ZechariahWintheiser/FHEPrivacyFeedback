import { expect } from "chai";
import { ethers } from "hardhat";
import type { PrivacyFeedback } from "../types";
import type { HardhatEthersSigner } from "@nomicfoundation/hardhat-ethers/signers";

type Signers = {
  deployer: HardhatEthersSigner;
  alice: HardhatEthersSigner;
  bob: HardhatEthersSigner;
  charlie: HardhatEthersSigner;
};

describe("PrivacyFeedback", function () {
  let signers: Signers;
  let contract: PrivacyFeedback;
  let contractAddress: string;

  async function deployFixture() {
    const factory = await ethers.getContractFactory("PrivacyFeedback");
    const contract = await factory.deploy() as PrivacyFeedback;
    await contract.waitForDeployment();
    const contractAddress = await contract.getAddress();

    return { contract, contractAddress };
  }

  before(async function () {
    const ethSigners = await ethers.getSigners();
    signers = {
      deployer: ethSigners[0],
      alice: ethSigners[1],
      bob: ethSigners[2],
      charlie: ethSigners[3],
    };
  });

  beforeEach(async function () {
    ({ contract, contractAddress } = await deployFixture());
  });

  describe("Deployment", function () {
    it("should deploy successfully", async function () {
      expect(await contract.getAddress()).to.be.properAddress;
    });

    it("should set owner correctly", async function () {
      expect(await contract.owner()).to.equal(signers.deployer.address);
    });

    it("should initialize with zero feedback counter", async function () {
      expect(await contract.feedbackCounter()).to.equal(0);
    });

    it("should initialize analysis as not ready", async function () {
      const analysis = await contract.currentAnalysis();
      expect(analysis.isReady).to.be.false;
    });
  });

  describe("Submit Feedback", function () {
    describe("Valid Submissions", function () {
      it("should submit feedback with valid parameters", async function () {
        const tx = await contract.connect(signers.alice).submitFeedback(5, 3, 8);
        await expect(tx).to.emit(contract, "FeedbackSubmitted").withArgs(signers.alice.address, 1);
      });

      it("should increment feedback counter", async function () {
        await contract.connect(signers.alice).submitFeedback(4, 2, 7);
        expect(await contract.feedbackCounter()).to.equal(1);
      });

      it("should store multiple feedbacks", async function () {
        await contract.connect(signers.alice).submitFeedback(5, 1, 9);
        await contract.connect(signers.bob).submitFeedback(3, 2, 6);
        await contract.connect(signers.charlie).submitFeedback(4, 3, 7);

        expect(await contract.feedbackCounter()).to.equal(3);
      });

      it("should track user feedback count", async function () {
        await contract.connect(signers.alice).submitFeedback(5, 1, 8);
        await contract.connect(signers.alice).submitFeedback(4, 2, 7);

        expect(await contract.getUserFeedbackCount(signers.alice.address)).to.equal(2);
      });

      it("should accept minimum valid rating (1)", async function () {
        const tx = await contract.connect(signers.alice).submitFeedback(1, 5, 5);
        await expect(tx).to.emit(contract, "FeedbackSubmitted");
      });

      it("should accept maximum valid rating (5)", async function () {
        const tx = await contract.connect(signers.alice).submitFeedback(5, 5, 5);
        await expect(tx).to.emit(contract, "FeedbackSubmitted");
      });

      it("should accept minimum valid category (1)", async function () {
        const tx = await contract.connect(signers.alice).submitFeedback(3, 1, 5);
        await expect(tx).to.emit(contract, "FeedbackSubmitted");
      });

      it("should accept maximum valid category (10)", async function () {
        const tx = await contract.connect(signers.alice).submitFeedback(3, 10, 5);
        await expect(tx).to.emit(contract, "FeedbackSubmitted");
      });

      it("should accept minimum valid sentiment (1)", async function () {
        const tx = await contract.connect(signers.alice).submitFeedback(3, 5, 1);
        await expect(tx).to.emit(contract, "FeedbackSubmitted");
      });

      it("should accept maximum valid sentiment (10)", async function () {
        const tx = await contract.connect(signers.alice).submitFeedback(3, 5, 10);
        await expect(tx).to.emit(contract, "FeedbackSubmitted");
      });
    });

    describe("Invalid Submissions", function () {
      it("should reject rating below minimum (0)", async function () {
        await expect(
          contract.connect(signers.alice).submitFeedback(0, 5, 5)
        ).to.be.revertedWith("Rating must be 1-5");
      });

      it("should reject rating above maximum (6)", async function () {
        await expect(
          contract.connect(signers.alice).submitFeedback(6, 5, 5)
        ).to.be.revertedWith("Rating must be 1-5");
      });

      it("should reject category below minimum (0)", async function () {
        await expect(
          contract.connect(signers.alice).submitFeedback(3, 0, 5)
        ).to.be.revertedWith("Category must be 1-10");
      });

      it("should reject category above maximum (11)", async function () {
        await expect(
          contract.connect(signers.alice).submitFeedback(3, 11, 5)
        ).to.be.revertedWith("Category must be 1-10");
      });

      it("should reject sentiment below minimum (0)", async function () {
        await expect(
          contract.connect(signers.alice).submitFeedback(3, 5, 0)
        ).to.be.revertedWith("Sentiment must be 1-10");
      });

      it("should reject sentiment above maximum (11)", async function () {
        await expect(
          contract.connect(signers.alice).submitFeedback(3, 5, 11)
        ).to.be.revertedWith("Sentiment must be 1-10");
      });
    });
  });

  describe("User Feedback Queries", function () {
    beforeEach(async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      await contract.connect(signers.alice).submitFeedback(4, 2, 7);
      await contract.connect(signers.bob).submitFeedback(3, 3, 6);
    });

    it("should return correct feedback count for user", async function () {
      expect(await contract.getUserFeedbackCount(signers.alice.address)).to.equal(2);
      expect(await contract.getUserFeedbackCount(signers.bob.address)).to.equal(1);
    });

    it("should return zero for user without feedback", async function () {
      expect(await contract.getUserFeedbackCount(signers.charlie.address)).to.equal(0);
    });

    it("should correctly identify users with feedback", async function () {
      expect(await contract.hasUserSubmittedFeedback(signers.alice.address)).to.be.true;
      expect(await contract.hasUserSubmittedFeedback(signers.bob.address)).to.be.true;
    });

    it("should correctly identify users without feedback", async function () {
      expect(await contract.hasUserSubmittedFeedback(signers.charlie.address)).to.be.false;
    });
  });

  describe("Confidential Analysis", function () {
    describe("Analysis Execution", function () {
      beforeEach(async function () {
        await contract.connect(signers.alice).submitFeedback(5, 1, 9);
        await contract.connect(signers.bob).submitFeedback(4, 2, 8);
        await contract.connect(signers.charlie).submitFeedback(3, 1, 7);
      });

      it("should perform analysis successfully", async function () {
        const tx = await contract.connect(signers.deployer).performConfidentialAnalysis();
        await expect(tx).to.emit(contract, "AnalysisCompleted");
      });

      it("should set analysis as ready", async function () {
        await contract.connect(signers.deployer).performConfidentialAnalysis();
        const analysis = await contract.currentAnalysis();
        expect(analysis.isReady).to.be.true;
      });

      it("should mark feedbacks as analyzed", async function () {
        await contract.connect(signers.deployer).performConfidentialAnalysis();
        const feedback1 = await contract.feedbacks(1);
        const feedback2 = await contract.feedbacks(2);
        expect(feedback1.isAnalyzed).to.be.true;
        expect(feedback2.isAnalyzed).to.be.true;
      });
    });

    describe("Analysis Authorization", function () {
      beforeEach(async function () {
        await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      });

      it("should allow owner to perform analysis", async function () {
        await expect(
          contract.connect(signers.deployer).performConfidentialAnalysis()
        ).to.not.be.reverted;
      });

      it("should reject non-owner analysis attempts", async function () {
        await expect(
          contract.connect(signers.alice).performConfidentialAnalysis()
        ).to.be.revertedWith("Not authorized");
      });

      it("should reject bob's analysis attempts", async function () {
        await expect(
          contract.connect(signers.bob).performConfidentialAnalysis()
        ).to.be.revertedWith("Not authorized");
      });
    });

    describe("Analysis Requirements", function () {
      it("should reject analysis with no feedback data", async function () {
        await expect(
          contract.connect(signers.deployer).performConfidentialAnalysis()
        ).to.be.revertedWith("No feedback data available");
      });

      it("should reject duplicate analysis of same data", async function () {
        await contract.connect(signers.alice).submitFeedback(5, 1, 8);
        await contract.connect(signers.deployer).performConfidentialAnalysis();

        await expect(
          contract.connect(signers.deployer).performConfidentialAnalysis()
        ).to.be.revertedWith("All feedback already analyzed");
      });

      it("should allow analysis of new feedback after previous analysis", async function () {
        await contract.connect(signers.alice).submitFeedback(5, 1, 8);
        await contract.connect(signers.deployer).performConfidentialAnalysis();

        await contract.connect(signers.bob).submitFeedback(4, 2, 7);
        await expect(
          contract.connect(signers.deployer).performConfidentialAnalysis()
        ).to.not.be.reverted;
      });
    });
  });

  describe("Analysis Decryption", function () {
    beforeEach(async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 9);
      await contract.connect(signers.bob).submitFeedback(4, 2, 8);
      await contract.connect(signers.deployer).performConfidentialAnalysis();
    });

    it("should allow owner to request decryption", async function () {
      await expect(
        contract.connect(signers.deployer).requestAnalysisDecryption()
      ).to.not.be.reverted;
    });

    it("should reject non-owner decryption requests", async function () {
      await expect(
        contract.connect(signers.alice).requestAnalysisDecryption()
      ).to.be.revertedWith("Not authorized");
    });

    it("should reject decryption when analysis not ready", async function () {
      await contract.connect(signers.deployer).resetAnalysis();

      await expect(
        contract.connect(signers.deployer).requestAnalysisDecryption()
      ).to.be.revertedWith("Analysis not ready");
    });
  });

  describe("Category Participation", function () {
    beforeEach(async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      await contract.connect(signers.bob).submitFeedback(4, 1, 7);
      await contract.connect(signers.charlie).submitFeedback(3, 2, 6);
    });

    it("should allow owner to check category participation", async function () {
      await expect(
        contract.connect(signers.deployer).getCategoryParticipation(1)
      ).to.not.be.reverted;
    });

    it("should reject non-owner category queries", async function () {
      await expect(
        contract.connect(signers.alice).getCategoryParticipation(1)
      ).to.be.revertedWith("Not authorized");
    });

    it("should reject invalid category (0)", async function () {
      await expect(
        contract.connect(signers.deployer).getCategoryParticipation(0)
      ).to.be.revertedWith("Invalid category");
    });

    it("should reject invalid category (11)", async function () {
      await expect(
        contract.connect(signers.deployer).getCategoryParticipation(11)
      ).to.be.revertedWith("Invalid category");
    });
  });

  describe("Privacy Violation Detection", function () {
    beforeEach(async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      await contract.connect(signers.bob).submitFeedback(4, 2, 7);
    });

    it("should allow owner to detect violations", async function () {
      const tx = await contract.connect(signers.deployer).detectPrivacyViolation(1);
      await expect(tx).to.emit(contract, "PrivacyViolationDetected");
    });

    it("should reject non-owner violation detection", async function () {
      await expect(
        contract.connect(signers.alice).detectPrivacyViolation(1)
      ).to.be.revertedWith("Not authorized");
    });

    it("should reject invalid feedback ID (0)", async function () {
      await expect(
        contract.connect(signers.deployer).detectPrivacyViolation(0)
      ).to.be.revertedWith("Invalid feedback ID");
    });

    it("should reject feedback ID beyond counter", async function () {
      await expect(
        contract.connect(signers.deployer).detectPrivacyViolation(999)
      ).to.be.revertedWith("Invalid feedback ID");
    });
  });

  describe("Public Statistics", function () {
    beforeEach(async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      await contract.connect(signers.bob).submitFeedback(4, 2, 7);
    });

    it("should return correct total feedbacks", async function () {
      const stats = await contract.getPublicStats();
      expect(stats.totalFeedbacks).to.equal(2);
    });

    it("should return correct analysis status", async function () {
      let stats = await contract.getPublicStats();
      expect(stats.analysisAvailable).to.be.false;

      await contract.connect(signers.deployer).performConfidentialAnalysis();

      stats = await contract.getPublicStats();
      expect(stats.analysisAvailable).to.be.true;
    });

    it("should return valid contract deploy time", async function () {
      const stats = await contract.getPublicStats();
      expect(stats.contractDeployTime).to.be.greaterThan(0);
    });

    it("should allow any user to view public stats", async function () {
      await expect(contract.connect(signers.alice).getPublicStats()).to.not.be.reverted;
      await expect(contract.connect(signers.bob).getPublicStats()).to.not.be.reverted;
      await expect(contract.connect(signers.charlie).getPublicStats()).to.not.be.reverted;
    });
  });

  describe("Reset Analysis", function () {
    beforeEach(async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      await contract.connect(signers.bob).submitFeedback(4, 2, 7);
      await contract.connect(signers.deployer).performConfidentialAnalysis();
    });

    it("should allow owner to reset analysis", async function () {
      await expect(
        contract.connect(signers.deployer).resetAnalysis()
      ).to.not.be.reverted;
    });

    it("should set analysis as not ready after reset", async function () {
      await contract.connect(signers.deployer).resetAnalysis();
      const analysis = await contract.currentAnalysis();
      expect(analysis.isReady).to.be.false;
    });

    it("should reject non-owner reset attempts", async function () {
      await expect(
        contract.connect(signers.alice).resetAnalysis()
      ).to.be.revertedWith("Not authorized");
    });
  });

  describe("Gas Optimization Tests", function () {
    it("should submit feedback with reasonable gas cost", async function () {
      const tx = await contract.connect(signers.alice).submitFeedback(5, 3, 8);
      const receipt = await tx.wait();
      expect(receipt?.gasUsed).to.be.lessThan(1000000);
    });

    it("should perform batch feedback submissions efficiently", async function () {
      const tx1 = await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      const receipt1 = await tx1.wait();

      const tx2 = await contract.connect(signers.bob).submitFeedback(4, 2, 7);
      const receipt2 = await tx2.wait();

      expect(receipt1?.gasUsed).to.be.greaterThan(0);
      expect(receipt2?.gasUsed).to.be.greaterThan(0);
    });

    it("should perform analysis with reasonable gas cost", async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      await contract.connect(signers.bob).submitFeedback(4, 2, 7);

      const tx = await contract.connect(signers.deployer).performConfidentialAnalysis();
      const receipt = await tx.wait();
      expect(receipt?.gasUsed).to.be.greaterThan(0);
    });
  });

  describe("Edge Cases and Security", function () {
    it("should handle single feedback submission", async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      expect(await contract.feedbackCounter()).to.equal(1);
    });

    it("should handle multiple submissions from same user", async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      await contract.connect(signers.alice).submitFeedback(4, 2, 7);
      await contract.connect(signers.alice).submitFeedback(3, 3, 6);

      expect(await contract.getUserFeedbackCount(signers.alice.address)).to.equal(3);
    });

    it("should maintain separate feedback counts per user", async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      await contract.connect(signers.alice).submitFeedback(4, 2, 7);
      await contract.connect(signers.bob).submitFeedback(3, 3, 6);

      expect(await contract.getUserFeedbackCount(signers.alice.address)).to.equal(2);
      expect(await contract.getUserFeedbackCount(signers.bob.address)).to.equal(1);
    });

    it("should handle all valid rating values", async function () {
      for (let rating = 1; rating <= 5; rating++) {
        await contract.connect(signers.alice).submitFeedback(rating, 5, 5);
      }
      expect(await contract.getUserFeedbackCount(signers.alice.address)).to.equal(5);
    });

    it("should handle all valid category values", async function () {
      for (let category = 1; category <= 10; category++) {
        await contract.connect(signers.alice).submitFeedback(3, category, 5);
      }
      expect(await contract.getUserFeedbackCount(signers.alice.address)).to.equal(10);
    });

    it("should store submitter address correctly", async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      const feedback = await contract.feedbacks(1);
      expect(feedback.submitter).to.equal(signers.alice.address);
    });

    it("should initialize feedback as not analyzed", async function () {
      await contract.connect(signers.alice).submitFeedback(5, 1, 8);
      const feedback = await contract.feedbacks(1);
      expect(feedback.isAnalyzed).to.be.false;
    });
  });
});
